<?xml version="1.0" ?>
<!--
  pista.sdf  -  Mundo para Gazebo Harmonic (generado con gen_pista.py)

  Circuito cerrado en sentido horario, ancho de pista 4 m (cara interna a cara interna),
  radio de curva 9 m (eje central). 228 muros con colision, 12 losas (rampas/plataforma),
  7 obstaculos cilindricos (0.5 m diametro x 1 m alto).

  SPAWN DEL ROBOT:  x=3  y=0  z=0.20  yaw=0   (mirando hacia +X, sobre la primera recta)
  Ejemplo:  ros2 run ros_gz_sim create -topic robot_description -x 3 -y 0 -z 0.20 -Y 0.0
-->
<sdf version="1.9">
  <world name="pista">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.6 0.75 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sol">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <!-- Suelo -->
    <model name="suelo">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>300 300</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>300 300</size></plane></geometry>
          <material><ambient>0.35 0.37 0.38 1</ambient><diffuse>0.35 0.37 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Marca visual del punto de spawn (sin colision) -->
    <model name="spawn_marker">
      <static>true</static>
      <pose>3 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>1.0 1.0 0.01</size></box></geometry>
          <material><ambient>0.1 0.8 0.2 1</ambient><diffuse>0.1 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Muros y rampas (un solo modelo estatico) -->
    <model name="pista">
      <static>true</static>
    <link name="muro_001_recta_01_inicio_i">
      <pose>5.0000 2.1000 0.5000 0 -0.00000 0.00000</pose>
      <collision name="c">
        <geometry><box><size>10.1000 0.2000 1.0000</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="v">
        <geometry><box><size>10.1000 0.2000 1.0000</size></box></geometry>
        <material><ambient>0.8 0.8 0.82 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
      </visual>
    </link>
