<?xml version="1.0"?>
<robot name="mi_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="rueda_radio" value="0.15"/>
  <xacro:property name="rueda_ancho" value="0.05"/>
  <xacro:property name="separacion_ruedas" value="0.25"/>

  <link name="base_link">
    <visual>
      <geometry><box size="0.7 0.2 0.15"/></geometry>
      <material name="azul"><color rgba="0.2 0.4 0.8 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.7 0.2 0.15"/></geometry>
    </collision>
    <inertial>
      <mass value="6.0"/>
      <inertia ixx="0.03125" ixy="0.0" ixz="0.0" iyy="0.25625" iyz="0.0" izz="0.26500"/>
    </inertial>
  </link>

  <xacro:macro name="rueda" params="prefijo y_signo">
    <link name="rueda_${prefijo}">
      <visual>
        <geometry><cylinder radius="${rueda_radio}" length="${rueda_ancho}"/></geometry>
        <material name="negro"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${rueda_radio}" length="${rueda_ancho}"/></geometry>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <inertia ixx="0.00583" ixy="0.0" ixz="0.0" iyy="0.0058333" iyz="0.0" izz="0.01125"/>
      </inertial>
    </link>

    <joint name="joint_rueda_${prefijo}" type="continuous">
      <parent link="base_link"/>
      <child link="rueda_${prefijo}"/>
      <origin xyz="-0.24 ${y_signo * separacion_ruedas/2} -0.02" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

  </xacro:macro>

  <xacro:rueda prefijo="izq1" y_signo="1"/>
  <xacro:rueda prefijo="der1" y_signo="-1"/>


   <!-- Apoyos (caster) adelante y atrás: sin ellos el robot se inclina y
       arrastra la caja contra el piso, lo que perturba el control. -->
  <xacro:property name="caster_radio" value="0.04"/>
  <xacro:macro name="caster" params="prefijo x">

    <link name="caster_${prefijo}">
      <collision>
        <geometry><sphere radius="${caster_radio}"/></geometry>
      </collision>
      <visual>
        <geometry><sphere radius="${caster_radio}"/></geometry>
        <material name="gris"><color rgba="0.6 0.6 0.6 1"/></material>
      </visual>
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
      </inertial>
    </link>

    <joint name="joint_caster_${prefijo}" type="fixed">
      <parent link="base_link"/>
      <child link="caster_${prefijo}"/>
      <!-- z: el fondo de la esfera queda a la altura del fondo de las ruedas -->
      <origin xyz="${x} 0 ${-0.03 - rueda_radio + caster_radio}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="caster_${prefijo}">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>

  </xacro:macro>
    <!-- aqui creo un caster --> 
  <xacro:caster prefijo="del" x="0.28"/>

    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>joint_rueda_izq1</left_joint>
            <right_joint>joint_rueda_der1</right_joint>
            <wheel_separation>${separacion_ruedas}</wheel_separation>
            <wheel_radius>${rueda_radio}</wheel_radius>
            <odom_publish_frequency>30</odom_publish_frequency>
            <topic>/model/mi_robot/cmd_vel</topic>
            <odom_topic>odom</odom_topic>
            <tf_topic>/tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
        </plugin>

        <!-- Publica el estado de las ruedas (para que RViz las dibuje girando) -->
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
    </gazebo>



    <link name="lidar_link">
        <visual><geometry><cylinder radius="0.03" length="0.04"/></geometry></visual>
        <collision><geometry><cylinder radius="0.03" length="0.04"/></geometry></collision>
        <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    </link>
    <joint name="joint_lidar" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0.1 0 0.095" rpy="0 0 0"/>
    </joint>





    <link name="camera_link">
        <visual><geometry><box size="0.02 0.05 0.02"/></geometry></visual>
        <collision><geometry><box size="0.02 0.05 0.02"/></geometry></collision>
        <inertial><mass value="0.02"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    </link>
    <joint name="joint_camera" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <origin xyz="0.36 0 0.03" rpy="0 0 0"/>
    </joint>


    <gazebo reference="lidar_link">
        <sensor name="lidar" type="gpu_lidar">
            <topic>scan</topic>
            <update_rate>10</update_rate>
            <lidar>
            <scan>
                <horizontal>
                <samples>360</samples>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.1</min>
                <max>10.0</max>
            </range>
            </lidar>
        </sensor>
    </gazebo>

    <gazebo reference="camera_link">
        <sensor name="camara" type="camera">
            <topic>image_raw</topic>
            <update_rate>30</update_rate>
            <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>1920</width><height>1080</height></image>
            <clip><near>0.1</near><far>20</far></clip>
            </camera>
        </sensor>
    </gazebo>


</robot>